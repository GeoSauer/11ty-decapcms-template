{
	"name": "11ty + DecapCMS Template",
	"version": "1.0.0",
	"description": "Based off of the official CodeStitch Intermediate kit.",
	"main": "index.js",
	"scripts": {
		"watch:cms": "npx decap-server",
		"watch:eleventy": "cross-env ELEVENTY_ENV=DEV eleventy --serve",
		"build:eleventy": "cross-env ELEVENTY_ENV=PROD eleventy",
		"start": "run-p watch:*",
		"build": "run-s build:*",
		"clean-build": "node -e \"require('node:fs').rmSync('public', { recursive: true, force: true })\" && npm run build",
		"preview": "cross-env ELEVENTY_ENV=PROD eleventy --serve",
		"test:unit": "node --test scripts/tests/*.test.js",
		"test:smoke": "node scripts/validate-site.js",
		"test:links": "node scripts/validate-external-links.js",
		"test": "npm run test:unit && npm run clean-build && npm run test:smoke",
		"check:launch": "node scripts/check-launch.js",
		"remove-dark-mode": "node scripts/remove-dark-mode.js",
		"remove-decap": "node scripts/remove-decap.js",
		"remove-demo": "node scripts/remove-demo.js",
		"create-page": "node scripts/create-page.js",
		"remove-page": "node scripts/remove-page.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GeoSauer/11ty-decapcms-template.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/GeoSauer/11ty-decapcms-template/issues"
	},
	"homepage": "https://github.com/GeoSauer/11ty-decapcms-template#readme",
	"dependencies": {
		"@11ty/eleventy": "^3.1.2",
		"@codestitchofficial/eleventy-plugin-minify": "^1.1.3",
		"@codestitchofficial/eleventy-plugin-sharp-images": "^2.2.0",
		"@quasibit/eleventy-plugin-sitemap": "^2.2.0",
		"autoprefixer": "^10.4.27",
		"codestitch-sharp-image-automation": "^0.4.0",
		"cross-env": "^10.1.0",
		"cssnano": "^7.1.2",
		"decap-server": "^3.5.2",
		"esbuild": "^0.27.3",
		"glob": "^13.0.6",
		"js-yaml": "^4.1.0",
		"markdown-it": "^14.1.1",
		"netlify-plugin-cache": "^1.0.3",
		"npm-run-all2": "^8.0.4",
		"postcss": "^8.5.8",
		"sass": "^1.97.3"
	}
}